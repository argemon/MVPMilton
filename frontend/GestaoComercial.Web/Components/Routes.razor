<Router AppAssembly="typeof(Program).Assembly"><Found Context="routeData">
<AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(LayoutPrincipal)"><NotAuthorized><RedirecionarAcesso Destino="@(context.User.Identity?.IsAuthenticated == true ? "/acesso-negado" : "/conta/entrar")" /></NotAuthorized></AuthorizeRouteView>
<FocusOnNavigate RouteData="routeData" Selector="h1" /></Found><NotFound><LayoutView Layout="typeof(LayoutPrincipal)"><h1>Página não encontrada</h1><a href="/">Voltar ao início</a></LayoutView></NotFound></Router>
