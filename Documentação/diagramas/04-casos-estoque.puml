@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam maxMessageSize 200
skinparam shadowing false
skinparam roundcorner 0
skinparam monochrome true
hide empty members
left to right direction
actor "Administrador" as A
actor "Vendedor" as V
actor "Estoquista" as E
rectangle "Gestão Comercial" {
usecase "UC13 Consultar saldos" as U13
usecase "UC14 Consultar movimentos" as U14
usecase "UC15 Registrar entrada" as U15
usecase "UC16 Registrar saída\nmanual" as U16
usecase "UC17 Ajustar por delta" as U17
}
A --> U13
A --> U14
A --> U15
A --> U16
A --> U17
V --> U13
E --> U13
E --> U14
E --> U15
E --> U16
@enduml
