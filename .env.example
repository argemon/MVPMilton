# Arquivo ilustrativo. Não substitua um .env existente.
# Use a URI Atlas real já fornecida somente no .env ignorado.
MONGODB_USERNAME="seu_usuario"
MONGODB_PASSWORD="sua_senha_externa"
MONGODB_URI="mongodb+srv://USUARIO:SENHA_ESCAPADA@SEU_CLUSTER/"
# Opcionais por host: variáveis reais do processo prevalecem sobre .env.
# Mongo__ConnectionString=URI_ESPECIFICA_DO_HOST
# Mongo__Database=gestao_comercial_dev (API) ou gestao_web_dev (Web)
# Api__BaseUrl=https://localhost:7143/
# Api__HealthBaseUrl=https://localhost:8081/
# Bootstrap__Nome=NOME_ILUSTRATIVO
# Bootstrap__Email=administrador@example.test
# Bootstrap__Senha=SEGREDO_EXTERNO_NAO_VERSIONADO
# TEST_MONGODB_URI=URI_DE_TESTE_EXTERNA (ou fallback Development em banco efêmero)
# TEST_MONGO_CONTAINER=true (somente perfil local/CI explícito)
